PAYMENT_MODE=mock
API_PORT=8787
APP_ORIGIN=http://localhost:5173
# Required in every runtime, including local mock mode. SQLite is test-only.
STORAGE_MODE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for sit/production. Keep the API token on the server.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
MERCHANT_NAME=Stussy Collection
MERCHANT_CITY=Phnom Penh
ORDER_CURRENCY=USD

# Optional ABA PayWay hosted card checkout. PAYWAY_API_KEY is the HMAC Public Key
# from PayWay (not the RSA Public Key). Keep all keys on the server.
PAYWAY_ENVIRONMENT=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# One-cent payment testing. Remove the unit price override and set shipping false for normal pricing.
TEST_UNIT_PRICE_MINOR=1
TEST_FREE_SHIPPING=true
